# Copy this file to ".env" to change a setting. Every line is optional:
# without a .env file the app uses the defaults shown here.

# Port of the web server (open http://localhost:3000)
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random text of your own.
JWT_SECRET=development-secret-change-me

# The admin account the server creates on its first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Where the data is stored (users, saved papers, reading list entries)
DATA_FILE=data/db.json

# Optional: a free OpenAlex API key raises the daily request limit 10x.
# Get one at https://openalex.org/settings/api - the app works without it.
OPENALEX_API_KEY=
